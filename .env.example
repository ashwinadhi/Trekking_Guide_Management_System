# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is gitignored and must never be committed.

# ─── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# ─── NextAuth (admin session) ───────────────────────────────────────────────
# Generate a strong secret, e.g. openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
# Used for absolute logo URLs in emails (optional; falls back to NEXTAUTH_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin login (stored in MongoDB) ────────────────────────────────────────
# Used only by `npm run seed:admin` to create or update the admin user.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# ─── Email (SMTP — Gmail, Outlook, etc.) ────────────────────────────────────
# Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-password-here
EMAIL_FROM=Nirvana Luxury Adventure <your.email@gmail.com>
# Inbox for contact forms, reviews, and new-booking alerts (defaults to SMTP_USER)
ADMIN_NOTIFY_EMAIL=your.email@gmail.com
